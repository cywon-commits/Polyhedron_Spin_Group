\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Landau free energies. (a) With a cubic invariant ($l=2$), a second minimum appears at finite amplitude and the transition is first order. (b) Without one ($l=3$), the minimum moves continuously away from zero. In the full theory the induced $l=4$ component can still make the $l=3$ transition weakly first order.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:landau}{{3}{5}{Landau free energies. (a) With a cubic invariant ($l=2$), a second minimum appears at finite amplitude and the transition is first order. (b) Without one ($l=3$), the minimum moves continuously away from zero. In the full theory the induced $l=4$ component can still make the $l=3$ transition weakly first order}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Defect classes of the T phase, labeled by their rotation angle $\theta $, with line energy $\propto \theta ^2$ (isotropic-stiffness estimate). The box lists the energetically favored splittings; the $C_2$ splitting is marginal and depends on elastic anisotropy.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:defects}{{4}{5}{Defect classes of the T phase, labeled by their rotation angle $\theta $, with line energy $\propto \theta ^2$ (isotropic-stiffness estimate). The box lists the energetically favored splittings; the $C_2$ splitting is marginal and depends on elastic anisotropy}{figure.4}{}}
