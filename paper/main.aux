\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Entropic ladder, Eq.~\eqref  {eq:ladder}, for the 2D model at $zG=1.1$. Thick segments mark the lower envelope (equilibrium phase); dotted lines are phase boundaries. (a) $n=4$: F$\to $M2$\to $C, boundaries at $u=0.411$ and $0.378$. (b) $n=6$: F$\to $M4$\to $M2$\to $C at $u=0.303$, $0.272$, $0.261$. Open circles on top: boundaries measured by slab coexistence, $u=(zG-J)/T$ ($n=6$: M4 resolved, M2 not); crosses in (a): thermodynamic-integration prediction.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:ladder}{{5}{6}{Entropic ladder, Eq.~\eqref {eq:ladder}, for the 2D model at $zG=1.1$. Thick segments mark the lower envelope (equilibrium phase); dotted lines are phase boundaries. (a) $n=4$: F$\to $M2$\to $C, boundaries at $u=0.411$ and $0.378$. (b) $n=6$: F$\to $M4$\to $M2$\to $C at $u=0.303$, $0.272$, $0.261$. Open circles on top: boundaries measured by slab coexistence, $u=(zG-J)/T$ ($n=6$: M4 resolved, M2 not); crosses in (a): thermodynamic-integration prediction}{figure.5}{}}
